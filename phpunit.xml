<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Authentication">
            <directory>tests/Feature/Authentication</directory>
        </testsuite>
        <testsuite name="CRUD">
            <directory>tests/Feature/Award</directory>
            <directory>tests/Feature/Basic</directory>
            <directory>tests/Feature/Certificate</directory>
            <directory>tests/Feature/Education</directory>
            <directory>tests/Feature/Interest</directory>
            <directory>tests/Feature/Language</directory>
            <directory>tests/Feature/Project</directory>
            <directory>tests/Feature/Publication</directory>
            <directory>tests/Feature/Reference</directory>
            <directory>tests/Feature/Skill</directory>
            <directory>tests/Feature/Volunteer</directory>
            <directory>tests/Feature/Work</directory>
        </testsuite>
        <testsuite name="MCP">
            <directory>tests/Feature/Mcp</directory>
        </testsuite>
        <testsuite name="Import">
            <directory>tests/Feature/Import</directory>
            <directory>tests/Feature/Console</directory>
        </testsuite>
        <testsuite name="Misc">
            <directory>tests/Feature/Bootstrap</directory>
            <directory>tests/Feature/Http</directory>
            <directory>tests/Feature/Iso</directory>
            <file>tests/Feature/ResumeModelObserverTest.php</file>
        </testsuite>
        <testsuite name="AI">
            <directory>tests/Feature/Chat</directory>
            <directory>tests/Feature/Embedding</directory>
            <directory>tests/Feature/Feature</directory>
            <file>tests/Feature/ResumeEmbeddingsContentTest.php</file>
            <file>tests/Feature/ResumeQATest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
